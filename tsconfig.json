{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@omnysync/contracts": ["packages/contracts/src/index.ts"],
      "@omnysync/financial-engine": ["packages/financial-engine/src/index.ts"],
      "@omnysync/platform": ["packages/platform/src/index.ts"],
      "@omnysync/ui": ["packages/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "**/dist", ".git"]
}
