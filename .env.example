# Omnysync ERP Environment Configuration Example

# Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000

# Database Configuration
# Supported drivers: "pglite" (in-memory/file wasm postgres) or "postgres" (network postgres)
DATABASE_DRIVER=pglite
DATABASE_DATA_DIR=./.data/pglite

# For standard PostgreSQL (when DATABASE_DRIVER=postgres)
DATABASE_URL=postgres://omnysync_app:omnysync_pass@localhost:5432/omnysync_erp
DATABASE_MIGRATION_URL=postgres://omnysync_admin:omnysync_admin_pass@localhost:5432/omnysync_erp

# Security & Sessions
JWT_SECRET=dev-secret-do-not-use-in-production-must-be-32-chars-minimum
SESSION_TTL_HOURS=24
CORS_ORIGIN=http://localhost:3000

# Demo / Synthetic Seed
ENABLE_SYNTHETIC_DEMO=true
DEMO_ORGANIZATION_NAME="Omnysync Global Trading LLC"
